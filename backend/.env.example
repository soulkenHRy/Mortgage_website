# Backend Environment Variables
# Copy this file to .env and update with your actual values

# ===== CRITICAL SECURITY VARIABLES (REQUIRED) =====

# MongoDB Connection (REQUIRED)
MONGODB_URI=mongodb://localhost:27017/mortgage-calculator

# JWT Secret (REQUIRED - generate a secure random string, minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===== OPTIONAL SERVICES =====

# Google Gemini AI API Key (for chatbot feature)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Email Configuration (SendGrid)
# Get your API key at: https://sendgrid.com
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# ===== SERVER CONFIGURATION =====

PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
# For local development:
FRONTEND_URL=http://localhost:5173
# For production (your deployed frontend):
# FRONTEND_URL=https://your-frontend-domain.com

# Client URL (for Socket.IO)
CLIENT_URL=http://localhost:5173

# Railway Deployment
# Once deployed on Railway, your backend will be available at:
# https://your-app-name.up.railway.app
# Update your frontend VITE_API_URL to point to this URL

# ===== SECURITY NOTES =====
# - Never commit the actual .env file to version control
# - Use strong, unique passwords and secrets
# - Keep your JWT_SECRET long and random (minimum 32 characters)
# - Rotate secrets regularly
# - Use different values for development and production
# - Enable environment variable validation in production
