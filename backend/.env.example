# Backend Environment Variables
# Copy this file to .env and update with your actual values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mortgage-calculator

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
# For local development:
FRONTEND_URL=http://localhost:5173
# For production (your deployed frontend):
# FRONTEND_URL=https://your-frontend-domain.com

# Railway Deployment
# Once deployed on Railway, your backend will be available at:
# https://your-app-name.up.railway.app
# Update your frontend VITE_API_URL to point to this URL

# Security Note:
# - Never commit the actual .env file
# - Use strong, unique passwords and secrets
# - For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
# - Keep your JWT_SECRET long and random (minimum 32 characters)
