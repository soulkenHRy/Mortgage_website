# Example environment variables
# Copy this file to .env and update the values

# Frontend API URL
# For local development:
# VITE_API_URL=http://localhost:3001

# For Railway deployment (backend on Railway):
VITE_API_URL=https://mortgagewebsite-production.up.railway.app

# For production (when deploying):
# VITE_API_URL=http://YOUR_PC_IP_ADDRESS:3001
# or if you have a domain:
# VITE_API_URL=https://api.yourdomain.com

# Note: Location data uses curated market information, not API scraping
# No Brave API keys are needed for location data functionality
